<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="JTS_App.Pages.AssistantPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:controls="using:JTS_App.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:JTS_App.ViewModels"
    mc:Ignorable="d">

    <Grid Padding="28,22,28,28" RowSpacing="18" Background="#181B20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Spacing="4">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Assistant" />
            <TextBlock Style="{StaticResource MutedTextBlockStyle}" Text="Talk naturally with the agent and prepare previews before changing Dataverse data." />
        </StackPanel>

        <Grid Grid.Row="1">
            <Border Style="{StaticResource PanelBorderStyle}">
                <Grid RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ListView ItemsSource="{x:Bind ViewModel.Messages, Mode=OneWay}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:ChatMessageView">
                            <controls:ChatMessageBubble
                                Message="{x:Bind}"
                                ApplyPreviewRequested="PreviewApply_Click"
                                CancelPreviewRequested="PreviewCancel_Click"
                                EditPreviewRequested="PreviewEdit_Click" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <Grid Grid.Row="1" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button
                        Click="RealtimeVoice_Click"
                        Style="{StaticResource JtsAccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontSize="14" Glyph="{x:Bind ViewModel.RealtimeVoiceButtonGlyph, Mode=OneWay}" />
                            <TextBlock Text="{x:Bind ViewModel.RealtimeVoiceButtonText, Mode=OneWay}" />
                        </StackPanel>
                    </Button>
                    <Button
                        Grid.Column="1"
                        Click="AgentAudio_Click"
                        IsEnabled="{x:Bind ViewModel.CanUseAgentAudioButton, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontSize="14" Glyph="{x:Bind ViewModel.AgentAudioButtonGlyph, Mode=OneWay}" />
                            <TextBlock Text="{x:Bind ViewModel.AgentAudioButtonText, Mode=OneWay}" />
                        </StackPanel>
                    </Button>
                    <ComboBox
                        Grid.Column="2"
                        Width="160"
                        ItemsSource="{x:Bind ViewModel.DeepSeekModelOptions}"
                        SelectedItem="{x:Bind ViewModel.SelectedDeepSeekModel, Mode=TwoWay}"
                        SelectionChanged="DeepSeekModel_SelectionChanged" />
                    <CheckBox
                        Grid.Column="3"
                        VerticalAlignment="Center"
                        Content="Thinking"
                        IsChecked="{x:Bind ViewModel.IsDeepSeekThinkingEnabled, Mode=TwoWay}"
                        Click="DeepSeekThinking_Click" />
                    <TextBlock
                        Grid.Column="4"
                        VerticalAlignment="Center"
                        Style="{StaticResource MutedTextBlockStyle}"
                        Text="{x:Bind ViewModel.VoiceSpeakingRateLabel, Mode=OneWay}" />
                    <Slider
                        Grid.Column="5"
                        Width="210"
                        Minimum="0.75"
                        Maximum="1.45"
                        StepFrequency="0.05"
                        Value="{x:Bind ViewModel.VoiceSpeakingRate, Mode=TwoWay}"
                        ValueChanged="VoiceSpeed_ValueChanged" />
                    <TextBlock
                        Grid.Column="6"
                        VerticalAlignment="Center"
                        Style="{StaticResource MutedTextBlockStyle}"
                        Text="{x:Bind ViewModel.RealtimeVoiceStatus, Mode=OneWay}"
                        TextWrapping="Wrap" />
                </Grid>
                <Grid Grid.Row="2" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox
                        x:Name="PromptBox"
                        AcceptsReturn="True"
                        KeyDown="Prompt_KeyDown"
                        KeyUp="Prompt_KeyUp"
                        PlaceholderText="Ask naturally. I will prepare a preview before changing Dataverse."
                        Text="{x:Bind ViewModel.Prompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        TextWrapping="Wrap" />
                    <Button Grid.Column="1" Click="Send_Click" Style="{StaticResource JtsAccentButtonStyle}" VerticalAlignment="Bottom">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontSize="14" Glyph="&#xE724;" />
                            <TextBlock Text="Send" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
