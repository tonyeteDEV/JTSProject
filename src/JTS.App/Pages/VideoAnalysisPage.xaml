<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="JTS_App.Pages.VideoAnalysisPage"
    x:Name="RootPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:JTS_App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:services="using:JTS_App.Services"
    xmlns:vm="using:JTS_App.ViewModels"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="StretchListViewItemStyle" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
        </Style>
    </Page.Resources>

    <Grid
        Padding="28,22,28,28"
        Background="#181B20"
        RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="4">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Video docs" />
            <TextBlock Style="{StaticResource MutedTextBlockStyle}" Text="Register screen recordings, link them to work, and prepare documentation drafts in Dataverse." />
        </StackPanel>

        <TabView
            x:Name="VideoTabs"
            Grid.Row="1"
            CanDragTabs="False"
            CanReorderTabs="False"
            IsAddTabButtonVisible="False">
            <TabViewItem
                x:Name="AnalysesTab"
                Header="New and recent analyses"
                IsClosable="False">
                <Grid Padding="0,14,0,0" ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.45*" MinWidth="560" />
                        <ColumnDefinition Width="*" MinWidth="420" />
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource PanelBorderStyle}">
                        <Grid RowSpacing="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="{x:Bind ViewModel.FormTitle, Mode=OneWay}" />

                            <Grid Grid.Row="1" ColumnSpacing="12" RowSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Project" />
                                    <ComboBox
                                        MinHeight="38"
                                        DisplayMemberPath="Name"
                                        ItemsSource="{x:Bind ViewModel.Projects, Mode=OneWay}"
                                        SelectedItem="{x:Bind ViewModel.SelectedProject, Mode=TwoWay}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="6">
                                    <TextBlock Text="Language" />
                                    <ComboBox
                                        MinHeight="38"
                                        ItemsSource="{x:Bind ViewModel.DocumentationLanguages, Mode=OneWay}"
                                        SelectedItem="{x:Bind ViewModel.SelectedDocumentationLanguage, Mode=TwoWay}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Spacing="6">
                                    <TextBlock Text="Video path or URL" />
                                    <TextBox
                                        MinHeight="38"
                                        PlaceholderText="Paste a local path, SharePoint link, or recording URL"
                                        Text="{x:Bind ViewModel.VideoPathOrUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Grid>

                            <StackPanel Grid.Row="2" Spacing="6">
                                <TextBlock Text="Initial context" />
                                <TextBox
                                    MinHeight="78"
                                    AcceptsReturn="True"
                                    PlaceholderText="What should the assistant know before processing this video?"
                                    Text="{x:Bind ViewModel.Context, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <Grid Grid.Row="3" RowSpacing="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Related tasks" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Style="{StaticResource MutedTextBlockStyle}"
                                        Text="{x:Bind ViewModel.SelectedTaskCount, Mode=OneWay}" />
                                </Grid>
                                <ListView
                                    Grid.Row="1"
                                    ItemContainerStyle="{StaticResource StretchListViewItemStyle}"
                                    ItemsSource="{x:Bind ViewModel.Tasks, Mode=OneWay}"
                                    SelectionMode="None">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="vm:VideoTaskOption">
                                            <Grid Padding="8,6" ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <CheckBox
                                                    VerticalAlignment="Center"
                                                    Checked="TaskSelection_Changed"
                                                    IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                                    Unchecked="TaskSelection_Changed" />
                                                <StackPanel Grid.Column="1" Spacing="2">
                                                    <TextBlock
                                                        FontWeight="SemiBold"
                                                        Text="{x:Bind Title}"
                                                        TextWrapping="Wrap" />
                                                    <TextBlock
                                                        Style="{StaticResource MutedTextBlockStyle}"
                                                        Text="{x:Bind Detail}"
                                                        TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Grid>

                            <Grid Grid.Row="4" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Spacing="6">
                                    <TextBlock
                                        Style="{StaticResource MutedTextBlockStyle}"
                                        Text="{x:Bind ViewModel.Status, Mode=OneWay}"
                                        TextWrapping="Wrap" />
                                    <Grid Visibility="{x:Bind ViewModel.HasProcessingProgress, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" RowSpacing="4">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                Style="{StaticResource MutedTextBlockStyle}"
                                                Text="{x:Bind ViewModel.ProcessingProgressText, Mode=OneWay}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                Grid.Column="1"
                                                Style="{StaticResource MutedTextBlockStyle}"
                                                Text="{x:Bind ViewModel.ProcessingTimingText, Mode=OneWay}" />
                                        </Grid>
                                        <ProgressBar
                                            Grid.Row="1"
                                            Maximum="100"
                                            Value="{x:Bind ViewModel.ProcessingPercent, Mode=OneWay}" />
                                    </Grid>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                    <Button
                                        Click="CancelEdit_Click"
                                        Visibility="{x:Bind ViewModel.IsEditing, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon FontSize="14" Glyph="&#xE711;" />
                                            <TextBlock Text="Cancel edit" />
                                        </StackPanel>
                                    </Button>
                                    <Button
                                        Click="SaveDraft_Click"
                                        Style="{StaticResource JtsAccentButtonStyle}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon FontSize="14" Glyph="&#xE74E;" />
                                            <TextBlock Text="{x:Bind ViewModel.PrimaryButtonText, Mode=OneWay}" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource PanelBorderStyle}">
                        <Grid RowSpacing="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Recent analyses" />
                            <ListView
                                Grid.Row="1"
                                ItemContainerStyle="{StaticResource StretchListViewItemStyle}"
                                ItemsSource="{x:Bind ViewModel.RecentAnalyses, Mode=OneWay}"
                                SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="services:VideoAnalysisRecord">
                                        <Border
                                            Margin="0,0,0,8"
                                            Padding="12"
                                            Background="#20262E"
                                            BorderBrush="#374151"
                                            BorderThickness="1"
                                            CornerRadius="8">
                                            <StackPanel Spacing="5">
                                                <TextBlock
                                                    FontWeight="SemiBold"
                                                    Text="{x:Bind Name}"
                                                    TextWrapping="Wrap" />
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock
                                                        Style="{StaticResource MutedTextBlockStyle}"
                                                        Text="{x:Bind ProjectName}"
                                                        TextTrimming="CharacterEllipsis" />
                                                    <Border
                                                        Grid.Column="1"
                                                        Padding="7,3"
                                                        Background="#1F3B2F"
                                                        CornerRadius="10">
                                                        <TextBlock FontSize="12" Text="{x:Bind StatusText}" />
                                                    </Border>
                                                </Grid>
                                                <TextBlock
                                                    FontSize="12"
                                                    Foreground="#8F9AAA"
                                                    Text="{x:Bind CreatedAtText}" />
                                                <TextBlock
                                                    Style="{StaticResource MutedTextBlockStyle}"
                                                    Text="{x:Bind VideoPathOrUrl}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <Button
                                                        Click="ViewRecent_Click"
                                                        Tag="{x:Bind Id}">
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <FontIcon FontSize="12" Glyph="&#xE8A7;" />
                                                            <TextBlock Text="View" />
                                                        </StackPanel>
                                                    </Button>
                                                    <Button
                                                        Click="ProcessRecent_Click"
                                                        IsEnabled="{x:Bind CanProcess}"
                                                        Tag="{x:Bind Id}">
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <FontIcon FontSize="12" Glyph="&#xE768;" />
                                                            <TextBlock Text="Process" />
                                                        </StackPanel>
                                                    </Button>
                                                    <Button
                                                        Click="EditRecent_Click"
                                                        IsEnabled="{x:Bind CanModify}"
                                                        Tag="{x:Bind Id}">
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <FontIcon FontSize="12" Glyph="&#xE70F;" />
                                                            <TextBlock Text="Edit" />
                                                        </StackPanel>
                                                    </Button>
                                                    <Button
                                                        Click="DeleteRecent_Click"
                                                        IsEnabled="{x:Bind CanDelete}"
                                                        Tag="{x:Bind Id}">
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <FontIcon FontSize="12" Glyph="&#xE74D;" />
                                                            <TextBlock Text="Delete" />
                                                        </StackPanel>
                                                    </Button>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Border>
                </Grid>
            </TabViewItem>

            <TabViewItem
                x:Name="AnalysisDetailTab"
                Header="Analysis detail"
                IsClosable="False">
                <Border Padding="0,14,0,0" Background="Transparent">
                    <Border Style="{StaticResource PanelBorderStyle}">
                        <Grid RowSpacing="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Analysis detail" />
                                    <TextBlock Style="{StaticResource MutedTextBlockStyle}" Text="Edit generated documentation or switch to Markdown preview." />
                                </StackPanel>
                                <ToggleSwitch
                                    Grid.Column="1"
                                    Header="Markdown preview"
                                    IsOn="{x:Bind ViewModel.IsMarkdownPreviewEnabled, Mode=TwoWay}"
                                    OffContent="Edit"
                                    OnContent="Preview" />
                                <Button
                                    Grid.Column="2"
                                    VerticalAlignment="Bottom"
                                    Click="SaveAnalysisChanges_Click"
                                    IsEnabled="{x:Bind ViewModel.HasSelectedAnalysisDetails, Mode=OneWay}"
                                    Style="{StaticResource JtsAccentButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon FontSize="14" Glyph="&#xE74E;" />
                                        <TextBlock Text="Save changes" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <ScrollViewer
                                Grid.Row="1"
                                VerticalScrollBarVisibility="Auto"
                                VerticalScrollMode="Auto">
                                <Grid
                                    RowSpacing="12"
                                    Visibility="{x:Bind ViewModel.HasSelectedAnalysisDetails, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Border Padding="12" Background="#20262E" BorderBrush="#374151" BorderThickness="1" CornerRadius="8">
                                        <StackPanel Spacing="4">
                                            <TextBlock
                                                FontWeight="SemiBold"
                                                Text="{x:Bind ViewModel.SelectedAnalysisName, Mode=OneWay}"
                                                TextWrapping="Wrap" />
                                            <TextBlock
                                                Style="{StaticResource MutedTextBlockStyle}"
                                                Text="{x:Bind ViewModel.SelectedAnalysisProjectName, Mode=OneWay}"
                                                TextWrapping="Wrap" />
                                            <TextBlock
                                                Style="{StaticResource MutedTextBlockStyle}"
                                                Text="{x:Bind ViewModel.SelectedAnalysisStatusText, Mode=OneWay}" />
                                            <TextBlock
                                                Style="{StaticResource MutedTextBlockStyle}"
                                                Text="{x:Bind ViewModel.SelectedAnalysisCreatedAtText, Mode=OneWay}" />
                                            <TextBlock
                                                Style="{StaticResource MutedTextBlockStyle}"
                                                Text="{x:Bind ViewModel.SelectedAnalysisVideoPathOrUrl, Mode=OneWay}"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>

                                    <StackPanel Grid.Row="1" Spacing="6">
                                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Summary" />
                                        <TextBox
                                            MinHeight="74"
                                            IsReadOnly="True"
                                            Text="{x:Bind ViewModel.SelectedAnalysisSummary, Mode=OneWay}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="2" Spacing="6">
                                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Global documentation" />
                                        <TextBox
                                            MinHeight="260"
                                            AcceptsReturn="True"
                                            Text="{x:Bind ViewModel.SelectedAnalysisGlobalDocumentation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            TextWrapping="Wrap"
                                            Visibility="{x:Bind ViewModel.IsMarkdownEditorVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <Border
                                            Padding="12"
                                            Background="#1D232B"
                                            BorderBrush="#374151"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Visibility="{x:Bind ViewModel.IsMarkdownPreviewEnabled, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <controls:MarkdownPreviewControl Text="{x:Bind ViewModel.SelectedAnalysisGlobalDocumentation, Mode=OneWay}" />
                                        </Border>
                                    </StackPanel>

                                    <Grid Grid.Row="3" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="6">
                                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Transcript" />
                                            <TextBox
                                                MinHeight="140"
                                                AcceptsReturn="True"
                                                IsReadOnly="True"
                                                Text="{x:Bind ViewModel.SelectedAnalysisTranscript, Mode=OneWay}"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="6">
                                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Visual OCR" />
                                            <TextBox
                                                MinHeight="140"
                                                AcceptsReturn="True"
                                                IsReadOnly="True"
                                                Text="{x:Bind ViewModel.SelectedAnalysisVisualOcr, Mode=OneWay}"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel Grid.Row="4" Spacing="8">
                                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Documentation by task" />
                                        <ItemsControl ItemsSource="{x:Bind ViewModel.SelectedAnalysisDocuments, Mode=OneWay}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:VideoAnalysisDocumentEditor">
                                                    <Border Margin="0,0,0,8" Padding="12" Background="#1D232B" BorderBrush="#374151" BorderThickness="1" CornerRadius="8">
                                                        <StackPanel Spacing="6">
                                                            <TextBlock FontWeight="SemiBold" Text="{x:Bind Name}" TextWrapping="Wrap" />
                                                            <TextBlock Style="{StaticResource MutedTextBlockStyle}" Text="{x:Bind TaskName}" TextWrapping="Wrap" />
                                                            <Grid ColumnSpacing="8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Style="{StaticResource MutedTextBlockStyle}" Text="{x:Bind StatusText}" />
                                                                <TextBlock Grid.Column="1" Style="{StaticResource MutedTextBlockStyle}" Text="{x:Bind CreatedAtText}" />
                                                            </Grid>
                                                            <TextBox
                                                                MinHeight="220"
                                                                AcceptsReturn="True"
                                                                Text="{x:Bind Markdown, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                TextWrapping="Wrap"
                                                                Visibility="{Binding ViewModel.IsMarkdownEditorVisible, ElementName=RootPage, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                            <Border
                                                                Padding="12"
                                                                Background="#20262E"
                                                                BorderBrush="#374151"
                                                                BorderThickness="1"
                                                                CornerRadius="8"
                                                                Visibility="{Binding ViewModel.IsMarkdownPreviewEnabled, ElementName=RootPage, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                <controls:MarkdownPreviewControl Text="{x:Bind Markdown, Mode=OneWay}" />
                                                            </Border>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Grid>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Border>
            </TabViewItem>
        </TabView>
    </Grid>
</Page>
