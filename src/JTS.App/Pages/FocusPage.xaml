<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="JTS_App.Pages.FocusPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:JTS_App.ViewModels"
    mc:Ignorable="d">

    <Grid Padding="28,22,28,28" RowSpacing="18" Background="#181B20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="4">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Focus" />
            <TextBlock Style="{StaticResource MutedTextBlockStyle}" Text="Track time directly against today's, tomorrow's, and future tasks." />
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource PanelBorderStyle}">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Tasks" />
                    <TabView
                        Grid.Row="1"
                        IsAddTabButtonVisible="False"
                        TabWidthMode="Equal">
                        <TabViewItem Header="Today" IsClosable="False">
                            <ListView
                                IsItemClickEnabled="True"
                                ItemClick="TaskList_ItemClick"
                                ItemsSource="{x:Bind ViewModel.TodayTasks, Mode=OneWay}"
                                SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:FocusTaskOption">
                                        <Border Padding="10" Margin="0,0,0,8" Background="{x:Bind ProjectColorHex, Converter={StaticResource ProjectColorBrushConverter}}" CornerRadius="6">
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="{x:Bind Title}" Foreground="#FFFFFF" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <TextBlock Text="{x:Bind Detail}" Foreground="#FFFFFF" Opacity="0.9" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </TabViewItem>
                        <TabViewItem Header="Tomorrow" IsClosable="False">
                            <ListView
                                IsItemClickEnabled="True"
                                ItemClick="TaskList_ItemClick"
                                ItemsSource="{x:Bind ViewModel.TomorrowTasks, Mode=OneWay}"
                                SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:FocusTaskOption">
                                        <Border Padding="10" Margin="0,0,0,8" Background="{x:Bind ProjectColorHex, Converter={StaticResource ProjectColorBrushConverter}}" CornerRadius="6">
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="{x:Bind Title}" Foreground="#FFFFFF" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <TextBlock Text="{x:Bind Detail}" Foreground="#FFFFFF" Opacity="0.9" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </TabViewItem>
                        <TabViewItem Header="Future" IsClosable="False">
                            <ListView
                                IsItemClickEnabled="True"
                                ItemClick="TaskList_ItemClick"
                                ItemsSource="{x:Bind ViewModel.FutureTasks, Mode=OneWay}"
                                SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:FocusTaskOption">
                                        <Border Padding="10" Margin="0,0,0,8" Background="{x:Bind ProjectColorHex, Converter={StaticResource ProjectColorBrushConverter}}" CornerRadius="6">
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="{x:Bind Title}" Foreground="#FFFFFF" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <TextBlock Text="{x:Bind Detail}" Foreground="#FFFFFF" Opacity="0.9" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </TabViewItem>
                    </TabView>
                </Grid>
            </Border>

            <Grid Grid.Column="1" RowSpacing="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Padding="24" Style="{StaticResource PanelBorderStyle}">
                        <StackPanel Spacing="12" HorizontalAlignment="Center">
                            <TextBlock HorizontalAlignment="Center" Style="{StaticResource MutedTextBlockStyle}" Text="{x:Bind ViewModel.SessionLabel, Mode=OneWay}" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                FontSize="72"
                                FontWeight="SemiBold"
                                Text="{x:Bind ViewModel.TimerText, Mode=OneWay}" />
                            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="8">
                                <Button Click="StartWork_Click" IsEnabled="{x:Bind ViewModel.SelectedTask, Mode=OneWay, Converter={StaticResource NotNullToBoolConverter}}" Style="{StaticResource JtsAccentButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon FontSize="14" Glyph="&#xE768;" />
                                        <TextBlock Text="Start" />
                                    </StackPanel>
                                </Button>
                                <Button Click="StopTracking_Click" IsEnabled="{x:Bind ViewModel.CanStopTracking, Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon FontSize="14" Glyph="&#xE777;" />
                                        <TextBlock Text="Stop" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Grid.Row="1" Style="{StaticResource PanelBorderStyle}">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="4">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind ViewModel.ActiveTaskLabel, Mode=OneWay}" TextWrapping="Wrap" />
                            <TextBlock Style="{StaticResource MutedTextBlockStyle}" Text="{x:Bind ViewModel.ActiveTaskTotalText, Mode=OneWay}" />
                            <TextBlock Style="{StaticResource MutedTextBlockStyle}" Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" TextWrapping="Wrap" />
                            <Border
                                Padding="10,8"
                                Background="#173B2B"
                                BorderBrush="#2F8A56"
                                BorderThickness="1"
                                CornerRadius="6"
                                Visibility="{x:Bind ViewModel.SelectedTaskHasTimesheetLinks, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock
                                    Foreground="#D5F8DF"
                                    Text="{x:Bind ViewModel.SelectedTaskLockMessage, Mode=OneWay}"
                                    TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>
                        <Button
                            Grid.Column="1"
                            VerticalAlignment="Top"
                            Click="DeleteSelectedTask_Click"
                            IsEnabled="{x:Bind ViewModel.CanDeleteSelectedTask, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontSize="14" Glyph="&#xE74D;" />
                                <TextBlock Text="Delete" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <Grid Grid.Row="2" ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="360" />
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource PanelBorderStyle}">
                        <Grid RowSpacing="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Resolution notes" />
                            <Grid Grid.Row="1" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox
                                    x:Name="JournalBox"
                                    AcceptsReturn="True"
                                    MinHeight="72"
                                    PlaceholderText="Add progress, decisions, blockers..."
                                    Text="{x:Bind ViewModel.JournalDraftText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    TextWrapping="Wrap" />
                                <Button Grid.Column="1" VerticalAlignment="Bottom" Click="AddJournal_Click" Style="{StaticResource JtsAccentButtonStyle}">
                                    <FontIcon FontSize="14" Glyph="&#xE724;" />
                                </Button>
                                <Button Grid.Column="2" VerticalAlignment="Bottom" Click="AudioNote_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon FontSize="14" Glyph="{x:Bind ViewModel.VoiceNoteButtonGlyph, Mode=OneWay}" />
                                        <TextBlock Text="{x:Bind ViewModel.VoiceNoteButtonText, Mode=OneWay}" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <Grid Grid.Row="2" RowSpacing="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Style="{StaticResource MutedTextBlockStyle}" Text="{x:Bind ViewModel.VoiceNoteStatus, Mode=OneWay}" TextWrapping="Wrap" />
                                <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.ActiveTaskJournal, Mode=OneWay}">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:FocusJournalEntryView">
                                        <Grid Padding="0,6,0,6" ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border
                                                Width="18"
                                                Height="18"
                                                Background="#2F8A56"
                                                CornerRadius="9"
                                                Visibility="{x:Bind IsTimesheetTransferred, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <FontIcon FontSize="10" Foreground="#FFFFFF" Glyph="&#xE73E;" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Spacing="4">
                                                <TextBlock Text="{x:Bind CreatedAtText}" Style="{StaticResource MutedTextBlockStyle}" />
                                                <TextBlock Text="{x:Bind Content}" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <Button Grid.Column="2" Tag="{x:Bind Id}" Click="EditJournal_Click" IsEnabled="{x:Bind IsEditable}">
                                                <FontIcon FontSize="14" Glyph="&#xE70F;" />
                                            </Button>
                                            <Button Grid.Column="3" Tag="{x:Bind Id}" Click="DeleteJournal_Click" IsEnabled="{x:Bind IsEditable}">
                                                <FontIcon FontSize="14" Glyph="&#xE74D;" />
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource PanelBorderStyle}">
                        <Grid RowSpacing="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="{x:Bind ViewModel.SummaryDateTitle, Mode=OneWay}" />
                            <TextBlock Grid.Row="1" Style="{StaticResource MutedTextBlockStyle}" Text="{x:Bind ViewModel.TodaySessionSummary, Mode=OneWay}" TextWrapping="Wrap" />
                            <StackPanel Grid.Row="2" Spacing="8">
                                <Button Click="ToggleSummaryCalendar_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon FontSize="14" Glyph="&#xE787;" />
                                        <TextBlock Text="{x:Bind ViewModel.SelectedSummaryDateText, Mode=OneWay}" />
                                    </StackPanel>
                                </Button>
                                <CalendarView
                                    x:Name="SummaryCalendar"
                                    FirstDayOfWeek="Monday"
                                    MaxHeight="320"
                                    Visibility="{x:Bind ViewModel.IsSummaryCalendarVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                    SelectionMode="Single"
                                    SelectedDatesChanged="SummaryCalendar_SelectedDatesChanged"
                                    CalendarViewDayItemChanging="SummaryCalendar_DayItemChanging" />
                            </StackPanel>
                            <TabView
                                Grid.Row="3"
                                IsAddTabButtonVisible="False"
                                TabWidthMode="Equal">
                                <TabViewItem Header="By task" IsClosable="False">
                                    <ListView ItemsSource="{x:Bind ViewModel.TodayTaskSummaries, Mode=OneWay}">
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="vm:FocusTaskSummaryView">
                                                <Grid Padding="0,6,0,6" ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{x:Bind TaskName}" TextWrapping="Wrap" />
                                                    <TextBlock Grid.Column="1" Text="{x:Bind TimeText}" Style="{StaticResource MutedTextBlockStyle}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </TabViewItem>
                                <TabViewItem Header="Slices" IsClosable="False">
                                    <ListView ItemsSource="{x:Bind ViewModel.TodayTimeSlices, Mode=OneWay}">
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="vm:FocusTimeSliceView">
                                                <Grid Padding="0,6,0,6" ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="78" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Style="{StaticResource MutedTextBlockStyle}" Text="{x:Bind TimeRangeText}" />
                                                    <StackPanel Grid.Column="1" Spacing="2">
                                                        <TextBlock Text="{x:Bind TaskName}" TextWrapping="Wrap" />
                                                        <TextBlock Style="{StaticResource MutedTextBlockStyle}" Text="{x:Bind ProjectName}" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2" Style="{StaticResource MutedTextBlockStyle}" Text="{x:Bind DurationText}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </TabViewItem>
                            </TabView>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Page>
