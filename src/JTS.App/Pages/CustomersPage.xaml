<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="JTS_App.Pages.CustomersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:entities="using:JTS.Data.Entities"
    xmlns:local="using:JTS_App.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="28,22,28,28" RowSpacing="18" Background="#181B20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Customers" />
            <TextBlock Style="{StaticResource MutedTextBlockStyle}" Text="Clients are synchronized from D365CE jts_cliente." />
        </StackPanel>

        <Border
            Grid.Row="1"
            Padding="12"
            Background="#2B3038"
            CornerRadius="8">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Click="SyncD365_Click" Style="{StaticResource JtsAccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="14" Glyph="&#xE895;" />
                        <TextBlock Text="Sync D365CE" />
                    </StackPanel>
                </Button>
                <TextBlock VerticalAlignment="Center" Style="{StaticResource MutedTextBlockStyle}" Text="{x:Bind ViewModel.Status, Mode=OneWay}" />
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource PanelBorderStyle}">
            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Padding="8,0,8,8" ColumnSpacing="18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Name" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock Grid.Column="1" Text="Website" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock Grid.Column="2" Text="Description" Style="{StaticResource BodyStrongTextBlockStyle}" />
                </Grid>

                <ListView
                    Grid.Row="1"
                    ItemsSource="{x:Bind ViewModel.Customers, Mode=OneWay}"
                    SelectedItem="{x:Bind ViewModel.SelectedCustomer, Mode=TwoWay}"
                    SelectionMode="Single">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="entities:Customer">
                            <Grid Padding="8,10,8,10" ColumnSpacing="18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="2*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Grid.Column="1" Text="{x:Bind ContactInfo}" Style="{StaticResource MutedTextBlockStyle}" />
                                <TextBlock Grid.Column="2" Text="{x:Bind Notes}" Style="{StaticResource MutedTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>
    </Grid>
</Page>
