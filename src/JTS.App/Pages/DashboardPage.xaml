<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="JTS_App.Pages.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:JTS_App.ViewModels"
    mc:Ignorable="d">

    <Grid Padding="28,22,28,28" RowSpacing="16" Background="#181B20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="4">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Dashboard" />
            <TextBlock Style="{StaticResource MutedTextBlockStyle}" Text="Actual time tracking, weekly summary, and timesheet generation." />
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource MetricCardBorderStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Style="{StaticResource MutedTextBlockStyle}" Text="Open tasks" />
                    <TextBlock Text="{x:Bind ViewModel.OpenTasksText, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource MetricCardBorderStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Style="{StaticResource MutedTextBlockStyle}" Text="Weekly time" />
                    <TextBlock Text="{x:Bind ViewModel.WeekTimeText, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource MetricCardBorderStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Style="{StaticResource MutedTextBlockStyle}" Text="Pending timesheet" />
                    <TextBlock Text="{x:Bind ViewModel.TimesheetReadyText, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="2" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*" />
                <ColumnDefinition Width="1.4*" />
            </Grid.ColumnDefinitions>

            <Grid RowSpacing="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Style="{StaticResource PanelBorderStyle}">
                    <Grid RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Time by project" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.ProjectTimeRows, Mode=OneWay}">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:DashboardProjectTimeRow">
                                    <Grid Padding="8" ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="86" />
                                            <ColumnDefinition Width="96" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="{x:Bind Project}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind Customer}" Style="{StaticResource MutedTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind Description}" Style="{StaticResource MutedTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{x:Bind Total}" HorizontalAlignment="Right" />
                                        <TextBlock Grid.Column="2" Text="{x:Bind Exported}" Style="{StaticResource MutedTextBlockStyle}" HorizontalAlignment="Right" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource PanelBorderStyle}">
                    <Grid RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Time by task" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.TaskTimeRows, Mode=OneWay}">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:DashboardTaskTimeRow">
                                    <Grid Padding="8" ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="92" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="{x:Bind Task}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind Project}" Style="{StaticResource MutedTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind Customer}" Style="{StaticResource MutedTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{x:Bind Total}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Column="1" Style="{StaticResource PanelBorderStyle}">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Spacing="4">
                        <TextBlock Text="Timesheet" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.TimesheetStatus, Mode=OneWay}" Style="{StaticResource MutedTextBlockStyle}" />
                    </StackPanel>

                    <Grid Grid.Row="1" ColumnSpacing="12" RowSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <CalendarDatePicker
                            Header="From"
                            FirstDayOfWeek="Monday"
                            HorizontalAlignment="Stretch"
                            Date="{x:Bind ViewModel.TimesheetStartDate, Mode=TwoWay}"
                            PlaceholderText="Select date" />
                        <TextBlock
                            Grid.Row="1"
                            Text="{x:Bind ViewModel.TimesheetStartDayText, Mode=OneWay}"
                            Style="{StaticResource MutedTextBlockStyle}"
                            TextWrapping="Wrap" />
                        <CalendarDatePicker
                            Grid.Column="1"
                            Header="To"
                            FirstDayOfWeek="Monday"
                            HorizontalAlignment="Stretch"
                            Date="{x:Bind ViewModel.TimesheetEndDate, Mode=TwoWay}"
                            PlaceholderText="Select date" />
                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="1"
                            Text="{x:Bind ViewModel.TimesheetEndDayText, Mode=OneWay}"
                            Style="{StaticResource MutedTextBlockStyle}"
                            TextWrapping="Wrap" />
                        <Button Grid.Column="2" VerticalAlignment="Bottom" Click="GenerateTimesheetPreview_Click" IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE9D9;" FontSize="14" />
                                <TextBlock Text="Preview" />
                            </StackPanel>
                        </Button>
                        <TextBlock Grid.Column="3" Text="{x:Bind ViewModel.TimesheetPreviewTotal, Mode=OneWay}" VerticalAlignment="Bottom" HorizontalAlignment="Right" Style="{StaticResource SubtitleTextBlockStyle}" />
                    </Grid>

                    <ListView Grid.Row="2" ItemsSource="{x:Bind ViewModel.TimesheetPreviewLines, Mode=OneWay}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:TimesheetPreviewLineView">
                                <Grid Padding="10" RowSpacing="6">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="80" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind Project}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind Date}" Style="{StaticResource MutedTextBlockStyle}" />
                                        <TextBlock Grid.Column="2" Text="{x:Bind Actual}" HorizontalAlignment="Right" />
                                        <TextBlock Grid.Column="3" Text="{x:Bind Rounded}" HorizontalAlignment="Right" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    </Grid>
                                    <TextBlock Grid.Row="1" Text="{x:Bind Summary}" Style="{StaticResource MutedTextBlockStyle}" TextWrapping="Wrap" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <Button Grid.Row="3" HorizontalAlignment="Right" Click="CreateTimesheet_Click" Style="{StaticResource JtsAccentButtonStyle}" IsEnabled="{x:Bind ViewModel.HasTimesheetPreview, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE73E;" FontSize="14" />
                            <TextBlock Text="Create timesheet" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
