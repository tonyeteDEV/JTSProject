<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="JTS_App.Pages.WeeklyPlannerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:JTS_App.ViewModels"
    mc:Ignorable="d">

    <Grid Padding="28,22,28,28" RowSpacing="14" Background="#181B20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="220" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Planner" />
                <TextBlock Style="{StaticResource MutedTextBlockStyle}" Text="{x:Bind WeekLabel, Mode=OneTime}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button Click="PreviousWeek_Click">
                    <FontIcon FontSize="14" Glyph="&#xE76B;" />
                </Button>
                <Button Click="CurrentWeek_Click" Content="This week" />
                <Button Click="NextWeek_Click">
                    <FontIcon FontSize="14" Glyph="&#xE76C;" />
                </Button>
                <Button
                    Click="Confirm_Click"
                    IsEnabled="{x:Bind ViewModel.HasPendingChanges, Mode=OneWay}"
                    Style="{StaticResource JtsAccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="14" Glyph="&#xE73E;" />
                        <TextBlock Text="Confirm changes" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="330" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource PanelBorderStyle}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="42" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid x:Name="CalendarHeaderGrid" />
                    <ScrollViewer
                        x:Name="CalendarScroll"
                        Grid.Row="1"
                        VerticalScrollMode="Auto"
                        VerticalScrollBarVisibility="Auto">
                        <Grid
                            x:Name="CalendarGrid"
                            MinHeight="1536"
                            AllowDrop="True"
                            DragLeave="CalendarGrid_DragLeave"
                            DragOver="CalendarGrid_DragOver"
                            Drop="CalendarGrid_Drop" />
                    </ScrollViewer>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource PanelBorderStyle}">
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Spacing="3">
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Task queue" />
                        <TextBlock Style="{StaticResource MutedTextBlockStyle}" Text="Drag a task onto the week or select one and click a slot." TextWrapping="Wrap" />
                    </StackPanel>
                    <TextBlock Grid.Row="1" Style="{StaticResource MutedTextBlockStyle}" Text="{x:Bind ViewModel.Status, Mode=OneWay}" TextWrapping="Wrap" />
                    <TabView
                        Grid.Row="2"
                        IsAddTabButtonVisible="False"
                        TabWidthMode="Equal">
                        <TabViewItem Header="Unplanned">
                            <ListView
                                x:Name="PendingList"
                                CanDragItems="True"
                                DragItemsStarting="TaskList_DragItemsStarting"
                                IsItemClickEnabled="True"
                                ItemClick="TaskList_ItemClick"
                                ItemsSource="{x:Bind ViewModel.PendingTasks, Mode=OneWay}"
                                SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:PlannerTaskView">
                                        <Border
                                            Padding="10"
                                            Margin="0,0,0,8"
                                            Background="{x:Bind ProjectColorHex, Converter={StaticResource ProjectColorBrushConverter}}"
                                            CornerRadius="6"
                                            Tag="{x:Bind Id}">
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="{x:Bind Title}" Foreground="#FFFFFF" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <TextBlock Text="{x:Bind ProjectName}" Foreground="#FFFFFF" Opacity="0.9" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{x:Bind Priority}" Foreground="#FFFFFF" Opacity="0.9" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </TabViewItem>
                        <TabViewItem Header="Planned">
                            <ListView
                                x:Name="AssignedList"
                                CanDragItems="True"
                                DragItemsStarting="TaskList_DragItemsStarting"
                                IsItemClickEnabled="True"
                                ItemClick="TaskList_ItemClick"
                                ItemsSource="{x:Bind ViewModel.AssignedTasks, Mode=OneWay}"
                                SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:PlannerTaskView">
                                        <Border
                                            Padding="10"
                                            Margin="0,0,0,8"
                                            Background="{x:Bind ProjectColorHex, Converter={StaticResource ProjectColorBrushConverter}}"
                                            CornerRadius="6"
                                            Tag="{x:Bind Id}">
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="{x:Bind Title}" Foreground="#FFFFFF" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <TextBlock Text="{x:Bind ProjectName}" Foreground="#FFFFFF" Opacity="0.9" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{x:Bind AssignmentSummary, Mode=OneWay}" Foreground="#FFFFFF" Opacity="0.9" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </TabViewItem>
                    </TabView>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource PanelBorderStyle}">
            <Grid ColumnSpacing="18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="8">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Selected task" />
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind ViewModel.SelectedTask.Title, Mode=OneWay, FallbackValue='Select a task'}" TextWrapping="Wrap" />
                    <TextBlock Style="{StaticResource MutedTextBlockStyle}" Text="{x:Bind ViewModel.SelectedTask.ProjectName, Mode=OneWay, FallbackValue=''}" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Style="{StaticResource MutedTextBlockStyle}" Text="{x:Bind ViewModel.SelectedTask.Priority, Mode=OneWay, FallbackValue=''}" />
                        <TextBlock Style="{StaticResource MutedTextBlockStyle}" Text="{x:Bind ViewModel.SelectedTask.EstimateLabel, Mode=OneWay, FallbackValue=''}" />
                        <TextBlock Style="{StaticResource MutedTextBlockStyle}" Text="{x:Bind ViewModel.SelectedTask.ActualLabel, Mode=OneWay, FallbackValue=''}" />
                    </StackPanel>
                </StackPanel>
                <Grid Grid.Column="1" RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Scheduled blocks" />
                    </Grid>
                    <ListView
                        x:Name="BlockDetailsList"
                        Grid.Row="1"
                        ItemsSource="{x:Bind ViewModel.SelectedTaskBlocks, Mode=OneWay}">
                        <ListView.Header>
                            <Grid Padding="4,0,4,4" ColumnSpacing="12" HorizontalAlignment="Left">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="44" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource MutedTextBlockStyle}" Text="Start date" />
                                <TextBlock Grid.Column="1" Style="{StaticResource MutedTextBlockStyle}" Text="Start" />
                                <TextBlock Grid.Column="2" Style="{StaticResource MutedTextBlockStyle}" Text="End date" />
                                <TextBlock Grid.Column="3" Style="{StaticResource MutedTextBlockStyle}" Text="End" />
                                <TextBlock Grid.Column="4" Style="{StaticResource MutedTextBlockStyle}" Text="Status" />
                            </Grid>
                        </ListView.Header>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:PlannerBlockView">
                                <Grid Padding="4" ColumnSpacing="12" HorizontalAlignment="Left">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="44" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Width="138" Padding="12,5" TextAlignment="Center" IsReadOnly="{x:Bind IsCompleted, Mode=OneTime}" Text="{x:Bind StartDateText, Mode=OneTime}" Tag="{x:Bind BlockId}" LostFocus="BlockStartDate_LostFocus" KeyDown="AssignmentTextBox_KeyDown" />
                                    <TextBox Grid.Column="1" Width="108" Padding="12,5" TextAlignment="Center" IsReadOnly="{x:Bind IsCompleted, Mode=OneTime}" Text="{x:Bind StartTimeText, Mode=OneTime}" Tag="{x:Bind BlockId}" LostFocus="BlockStartTime_LostFocus" KeyDown="AssignmentTextBox_KeyDown" />
                                    <TextBox Grid.Column="2" Width="138" Padding="12,5" TextAlignment="Center" IsReadOnly="{x:Bind IsCompleted, Mode=OneTime}" Text="{x:Bind EndDateText, Mode=OneTime}" Tag="{x:Bind BlockId}" LostFocus="BlockEndDate_LostFocus" KeyDown="AssignmentTextBox_KeyDown" />
                                    <TextBox Grid.Column="3" Width="108" Padding="12,5" TextAlignment="Center" IsReadOnly="{x:Bind IsCompleted, Mode=OneTime}" Text="{x:Bind EndTimeText, Mode=OneTime}" Tag="{x:Bind BlockId}" LostFocus="BlockEndTime_LostFocus" KeyDown="AssignmentTextBox_KeyDown" />
                                    <Border Grid.Column="4" Padding="8,5" Background="#243043" CornerRadius="6">
                                        <TextBlock Text="{x:Bind SyncLabel}" />
                                    </Border>
                                    <Button Grid.Column="5" Tag="{x:Bind BlockId}" IsEnabled="{x:Bind IsEditable, Mode=OneTime}" Click="DeleteBlock_Click">
                                        <FontIcon FontSize="12" Glyph="&#xE74D;" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Page>
