<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="JTS.Mobile.Pages.SettingsPage"
             Title="Settings"
             BackgroundColor="#111418">

    <ScrollView>
        <VerticalStackLayout Spacing="12" Padding="16,14,16,24">

            <Label Text="Settings" FontSize="24" FontAttributes="Bold" TextColor="White" />
            <Label x:Name="StatusLabel" Text="" FontSize="13" TextColor="#AEB6C2" />

            <!-- Dataverse section -->
            <Label Text="Dataverse connection" TextColor="White" FontSize="18" FontAttributes="Bold" Margin="0,8,0,0" />

            <Entry x:Name="EnvironmentEntry"
                   Placeholder="https://org.crm4.dynamics.com"
                   Keyboard="Plain" IsTextPredictionEnabled="False" IsSpellCheckEnabled="False"
                   BackgroundColor="#1E293B" TextColor="White" PlaceholderColor="#6B7280" />

            <Entry x:Name="TenantEntry"
                   Placeholder="Tenant ID"
                   Keyboard="Plain" IsTextPredictionEnabled="False" IsSpellCheckEnabled="False"
                   BackgroundColor="#1E293B" TextColor="White" PlaceholderColor="#6B7280" />

            <Entry x:Name="ClientEntry"
                   Placeholder="Client ID"
                   Keyboard="Plain" IsTextPredictionEnabled="False" IsSpellCheckEnabled="False"
                   BackgroundColor="#1E293B" TextColor="White" PlaceholderColor="#6B7280" />

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Entry x:Name="SecretEntry"
                       Placeholder="Client secret value" IsPassword="True"
                       Keyboard="Plain" IsTextPredictionEnabled="False" IsSpellCheckEnabled="False"
                       BackgroundColor="#1E293B" TextColor="White" PlaceholderColor="#6B7280" />
                <Button Grid.Column="1" Text="Paste" Clicked="OnPasteSecret"
                        BackgroundColor="#334155" TextColor="White" CornerRadius="8" />
            </Grid>

            <Label x:Name="SecretHintLabel"
                   Text="Paste the client secret VALUE, not the Secret ID."
                   TextColor="#6B7280" FontSize="12" />

            <BoxView HeightRequest="1" BackgroundColor="#1E293B" Margin="0,8" />

            <!-- AI section -->
            <Label Text="AI agent" TextColor="White" FontSize="18" FontAttributes="Bold" />

            <Entry x:Name="DeepSeekKeyEntry"
                   Placeholder="DeepSeek API key" IsPassword="True"
                   Keyboard="Plain" IsTextPredictionEnabled="False" IsSpellCheckEnabled="False"
                   BackgroundColor="#1E293B" TextColor="White" PlaceholderColor="#6B7280" />

            <Picker x:Name="DeepSeekModelPicker" Title="Model"
                    BackgroundColor="#1E293B" TextColor="White" TitleColor="#6B7280" />

            <HorizontalStackLayout Spacing="10">
                <CheckBox x:Name="DeepSeekThinkingCheckBox" Color="#3B82F6" />
                <Label Text="Thinking" TextColor="White" VerticalTextAlignment="Center" />
            </HorizontalStackLayout>

            <Button Text="Save and test connection" Clicked="OnSaveSettings"
                    BackgroundColor="#2563EB" TextColor="White" CornerRadius="10"
                    HeightRequest="48" Margin="0,8,0,0" />

            <Label Text="The secret is stored in the phone's secure storage."
                   TextColor="#6B7280" FontSize="12" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
