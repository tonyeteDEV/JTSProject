<?xml version="1.0" encoding="UTF-8" ?>
<Shell x:Class="JTS.Mobile.AppShell"
       xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       FlyoutBehavior="Disabled"
       Shell.BackgroundColor="#1A1F27"
       Shell.ForegroundColor="White"
       Shell.TitleColor="White"
       Shell.TabBarBackgroundColor="#1A1F27"
       Shell.TabBarForegroundColor="#AEB6C2"
       Shell.TabBarTitleColor="White"
       Shell.TabBarUnselectedColor="#4B5563">

    <TabBar>
        <Tab Title="Tasks">
            <ShellContent x:Name="TasksContent" Route="tasks" />
        </Tab>
        <Tab Title="Focus">
            <ShellContent x:Name="FocusContent" Route="focus" />
        </Tab>
        <Tab Title="Agent">
            <ShellContent x:Name="AgentContent" Route="agent" />
        </Tab>
        <Tab Title="Settings">
            <ShellContent x:Name="SettingsContent" Route="settings" />
        </Tab>
    </TabBar>

</Shell>
